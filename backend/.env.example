# Google Gemini (Default Provider)
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL_ID=text-embedding-004

# IBM watsonx.ai (Optional Fallback Provider)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-4-h-small

# Application
DATABASE_URL=sqlite+aiosqlite:///./storyglide.db

# Set to "true" to use stub responses instead of live API calls (for local dev/CI)
MOCK_AI=false

